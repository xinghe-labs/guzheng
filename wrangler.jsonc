{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guzheng",
  "main": "worker/worker.mjs",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "run_worker_first": ["/api/*", "/results/*", "/healthz"]
  },
  "observability": { "enabled": true }
}
